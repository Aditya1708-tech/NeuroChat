# ==============================================================================
# NeuroChat Backend Environment Configuration
# ==============================================================================
# NOTE: Never commit this file with real secrets to version control.
# Copy this file to .env and fill in your keys.

# --- Server ---
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5174
SERVER_URL=http://localhost:5001
TRUST_PROXY=0

# --- Database ---
# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/neurochat

# --- Authentication ---
# Generate a secure 32+ byte string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=neurochat_dev_jwt_secret_key_placeholder_min_32_bytes_long_12345
JWT_EXPIRES_SHORT=24h
JWT_EXPIRES_LONG=30d

# --- Google OAuth (Google Identity Services) ---
# Public client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
# Optional: only used if switching to Authorization Code flow
GOOGLE_CLIENT_SECRET=optional_google_client_secret_placeholder

# --- Google Gemini AI API ---
# Obtain your Gemini API Key from https://aistudio.google.com/app/apikey
# Keep this strictly in backend! Never expose to client/frontend.
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
