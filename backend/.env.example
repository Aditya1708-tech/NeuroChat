# ==============================================================================
# NeuroChat Backend Environment Configuration
# ==============================================================================
# NOTE: Never commit this file with real secrets to version control.
# Copy this file to .env and fill in your keys.

# --- Server ---
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
TRUST_PROXY=0

# --- Database ---
# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/neurochat

# --- Authentication ---
JWT_SECRET=neurochat_dev_jwt_secret_key_placeholder_min_32_bytes_long_12345
JWT_EXPIRES_SHORT=24h
JWT_EXPIRES_LONG=30d

# --- Google OAuth (Google Identity Services) ---
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=optional_google_client_secret_placeholder

# ==============================================================================
# AI Provider Responsibilities & Dedicated Keys
# ==============================================================================

# --- Provider A: Gemini API Key 1 (Chat Generation Exclusively) ---
# Used exclusively for text conversations, explanations, coding, and general Q&A.
# NEVER used for image generation.
GEMINI_API_KEY_1=your_first_gemini_api_key_placeholder
GEMINI_API_KEY=your_first_gemini_api_key_placeholder # Backwards-compatible alias
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Provider B: Gemini API Key 2 (Image Generation Exclusively) ---
# Used exclusively for AI image generation (gemini-3.1-flash-image / gemini-2.5-flash-image).
# NEVER used for chat generation.
# Note: Google AI Studio image generation models require pay-as-you-go billing enabled.
GEMINI_API_KEY_2=your_second_gemini_api_key_placeholder
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Provider C: NVIDIA Nemotron 3 Ultra (Alternative Chat Model) ---
# NVIDIA NIM API key (starts with nvapi-...) from https://build.nvidia.com
# Used as an independently selectable chat model for complex reasoning and coding.
# NEVER used for image generation.
NVIDIA_NEMOTRON_API_KEY=your_nvidia_api_key_placeholder
NVIDIA_API_KEY=your_nvidia_api_key_placeholder # Backwards-compatible alias
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Timeouts & Fallback Policies ---
AI_TIMEOUT_MS=180000
ALLOW_IMAGE_FALLBACK=true
