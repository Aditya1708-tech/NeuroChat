# NeuroChat Frontend Environment Variables
# NOTE: All variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER place backend secrets (like GEMINI_API_KEY or JWT_SECRET) here.

# API Base URL (defaults to /api via Vite development proxy)
VITE_API_BASE_URL=/api

# Google Identity Services OAuth Client ID (from Google Cloud or Firebase Web SDK configuration)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

# Firebase Web App Configuration (From Firebase Console > Project Settings > Your apps > Web app </>)
VITE_FIREBASE_API_KEY=your_firebase_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
